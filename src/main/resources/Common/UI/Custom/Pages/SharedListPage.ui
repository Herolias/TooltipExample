$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 500, Height: 600);

  #Title {
    Group {
      $C.@Title {
        @Text = "Shared Item List";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group #EmptyLabel {
      Anchor: (Height: 40);
      Label {
        Text: "No items in the list.";
        Style: (
          ...$C.@DefaultLabelStyle,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
          FontSize: 18
        );
      }
    }

    Group #ItemList {
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      FlexWeight: 1;
    }

    Group {
      Anchor: (Height: 15);
    }

    Group {
      LayoutMode: Left;
      Anchor: (Horizontal: 0);

      $C.@TextButton #ReturnAllButton {
        Text: "Return All to Inventory";
        FlexWeight: 1;
      }

      Group {
        Anchor: (Width: 10);
      }

      $C.@CancelTextButton #CloseButton {
        Text: "Close";
        FlexWeight: 1;
      }
    }
  }
}
