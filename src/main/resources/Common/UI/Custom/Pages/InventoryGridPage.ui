$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 470, Height: 420);

  #Title {
    Group {
      $C.@Title {
        @Text = "Inventory";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label {
      Text: "STORAGE";
      Padding: (Bottom: 4, Top: 4);
      Style: (
        ...$C.@DefaultLabelStyle,
        FontSize: 12,
        TextColor: #94969a,
        RenderUppercase: true
      );
    }

    Group #InvRow0 {
      LayoutMode: Left;
      Anchor: (Height: 46);
    }

    Group #InvRow1 {
      LayoutMode: Left;
      Anchor: (Height: 46);
    }

    Group #InvRow2 {
      LayoutMode: Left;
      Anchor: (Height: 46);
    }

    Group #InvRow3 {
      LayoutMode: Left;
      Anchor: (Height: 46);
    }

    Group {
      Anchor: (Height: 8);
    }

    Label {
      Text: "HOTBAR";
      Padding: (Bottom: 4);
      Style: (
        ...$C.@DefaultLabelStyle,
        FontSize: 12,
        TextColor: #94969a,
        RenderUppercase: true
      );
    }

    Group #HotbarRow {
      LayoutMode: Left;
      Anchor: (Height: 46);
    }

    Group {
      Anchor: (Height: 12);
    }

    Group {
      LayoutMode: Left;
      Anchor: (Horizontal: 0);

      $C.@TextButton #ConfirmButton {
        Text: "Add Selected to List";
        FlexWeight: 1;
      }

      Group {
        Anchor: (Width: 10);
      }

      $C.@CancelTextButton #CloseButton {
        Text: "Close";
        FlexWeight: 1;
      }
    }
  }
}
